# Backend environment variables

# Google Sheets service account credentials JSON file path
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Google Sheets spreadsheet ID (from the URL)
# https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Existing folder inside a Shared Drive where photos will be uploaded
# Example URL: https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
GOOGLE_DRIVE_FOLDER_ID=

# Optional: Shared Drive ID if you want the backend to search/create inside that drive
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Server
HOST=0.0.0.0
PORT=8000
