# Backend environment variables
# Copy this file to backend/.env.development or backend/.env.production
# and set APP_ENV accordingly when you need an explicit runtime mode.

APP_ENV=development

# Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=public
SUPABASE_STORAGE_BUCKET=livestock
SUPABASE_STORAGE_PREFIX=cattle-photos

# Auth
AUTH_TOKEN=

# CORS configuration
# Use CORS_ORIGINS for explicit origins and CORS_ALLOW_ORIGIN_REGEX
# when development viewers or dynamic localhost ports need flexibility.
CORS_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=

# Server
HOST=0.0.0.0
PORT=8000
